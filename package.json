{
  "name": "atlas-manager",
  "version": "1.0.0-rc.8",
  "description": "Self-hosted management and automation platform for the Atlas homelab server.",
  "private": true,
  "type": "module",
  "bin": {
    "atlas": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node --import tsx/esm scripts/generate-dashboard-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "release:generate-contract": "node scripts/generate-release-contract.mjs",
    "release:generate-dependencies": "node scripts/generate-production-dependencies.mjs",
    "release:generate-evidence": "node scripts/generate-release-evidence.mjs",
    "release:generate-traceability": "node scripts/generate-requirements-traceability.mjs",
    "release:generate-digests": "node scripts/generate-release-digests.mjs",
    "release:validate": "node scripts/validate-release-artifacts.mjs",
    "release:validate-snapshots": "node scripts/validate-versioned-release-snapshots.mjs",
    "dashboard:generate-assets": "node --import tsx/esm scripts/generate-dashboard-assets.mjs",
    "dashboard:verify-assets": "node scripts/verify-dashboard-assets.mjs",
    "package:operator": "node scripts/build-operator-package.mjs",
    "release:rehearse": "node scripts/run-release-rehearsal.mjs"
  },
  "keywords": [
    "homelab",
    "server-management",
    "automation",
    "typescript",
    "express"
  ],
  "author": "Gustavo Pinto",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jose": "^6.2.6",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
