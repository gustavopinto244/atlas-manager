HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
POWER_MANAGEMENT_BACKEND=mock
MACHINE_POWER_EFFECTS_ACTIVATION=disabled
MACHINE_POWER_SCHEDULER_ENABLED=false
MACHINE_OPERATING_POLICY={"mode":"always_on"}
REGISTERED_SERVICES_JSON=[{"id":"example-service","displayName":"Example Service","managementAdapter":"mock","externalResourceId":"example-service-target","supportedOperations":["readStatus","start","stop","restart"],"availabilityPolicy":{"mode":"manual"}}]
# CLOUDFLARE_ACCESS_TEAM_NAME=example-team
# CLOUDFLARE_ACCESS_AUDIENCE=replace-with-access-application-aud
# ADMINISTRATIVE_EVENT_HISTORY_HTTP_ENABLED=false
# ADMINISTRATIVE_SERVICE_MANAGEMENT_HTTP_ENABLED=false
# ADMINISTRATIVE_SERVICE_AVAILABILITY_HTTP_ENABLED=false
# ADMINISTRATIVE_OVERVIEW_HTTP_ENABLED=false
# ADMINISTRATIVE_DASHBOARD_ENABLED=false
# ADMINISTRATIVE_BACKUP_HTTP_ENABLED=false
# BACKUP_SCHEDULER_ENABLED=false
# REGISTERED_BACKUP_TARGETS_JSON=[]
# BACKUP_RUN_HISTORY_FILE=/var/lib/atlas-manager-backups/runs.jsonl
# BACKUP_SCHEDULER_CURSOR_FILE=/var/lib/atlas-manager-backups/scheduler-cursor.json
# BACKUP_OCCURRENCE_CLAIM_FILE=/var/lib/atlas-manager-backups/occurrence-claims.jsonl
# ADMINISTRATIVE_WAKE_ALARM_HTTP_ENABLED=false
# ADMINISTRATIVE_SHUTDOWN_HTTP_ENABLED=false
# ADMINISTRATIVE_EVENT_HISTORY_DIRECTORY=/var/lib/atlas-manager-event-history
# ADMINISTRATIVE_EVENT_HISTORY_OPERATIONS_HTTP_ENABLED=false
# ADMINISTRATIVE_EVENT_HISTORY_MAX_SEGMENT_EVENTS=10000
# ADMINISTRATIVE_EVENT_HISTORY_MAX_SEGMENT_BYTES=16777216
# ADMINISTRATIVE_EVENT_HISTORY_RETENTION_POLICY={"schemaVersion":1,"automaticPruneEnabled":false,"segments":{"minSealedSegments":2,"maxSealedSegments":100,"maxSealedSegmentAgeDays":365},"exports":{"minExports":1,"maxExports":32,"maxExportAgeDays":90}}
# ADMINISTRATIVE_EVENT_HISTORY_AUTOMATIC_RETENTION_ENABLED=false
