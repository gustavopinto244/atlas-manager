{
  "schemaVersion": 1,
  "cloudflareTeamName": "example-team",
  "cloudflareAudience": "replace-with-access-application-audience",
  "publicOrigin": "https://admin.gustavopinto.dev.br",
  "roleAssignments": [
    {
      "principalId": "caf45cc3-4312-5d41-8603-cc0102346a1f",
      "roles": ["administrator"]
    },
    {
      "principalId": "00000000-0000-4000-8000-000000000002",
      "roles": ["auditor", "service_operator", "backup_operator"]
    }
  ],
  "registeredServices": [],
  "backupSchedulerEnabled": false,
  "backupTargets": [
    {
      "id": "example-backup",
      "displayName": "Example backup",
      "kind": "mock",
      "schedule": { "mode": "manual" },
      "retention": { "keepLastSuccessful": 7 },
      "limits": {
        "maxFiles": 1000,
        "maxTotalBytes": 1073741824,
        "maxFileBytes": 268435456,
        "maxDepth": 16,
        "maxRelativePathBytes": 4096
      }
    }
  ],
  "eventHistoryOperations": {
    "enabled": true,
    "segment": { "maxEvents": 10000, "maxBytes": 16777216 },
    "retention": {
      "automaticPruneEnabled": false,
      "segments": {
        "minSealedSegments": 2,
        "maxSealedSegments": 100,
        "maxSealedSegmentAgeDays": 365
      },
      "exports": { "minExports": 1, "maxExports": 32, "maxExportAgeDays": 90 }
    }
  }
}
